---
// ProjectCard.astro
interface Props {
  title: string;
  description: string;
  repoUrl: string;
  role?: string;
  tags: string[];
  highlights?: string[];
  externalUrl?: string;
}

const { title, description, repoUrl, role, tags, highlights = [], externalUrl } = Astro.props;
---

<article class="project-card">
  <div class="project-top">
    <div class="project-header">
      <div>
        <h3 class="project-title">{title}</h3>
        {role && <span class="project-role">{role}</span>}
      </div>
      <div class="project-links">
        {externalUrl && (
          <a href={externalUrl} target="_blank" rel="noopener noreferrer" class="project-icon-link" aria-label={`View website for ${title}`} title="External Website">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        )}
        <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="project-icon-link" aria-label={`View GitHub repository for ${title}`} title="GitHub Repository">
          <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
        </a>
      </div>
    </div>

    <p class="project-desc">{description}</p>

    {highlights.length > 0 && (
      <ul class="project-highlights">
        {highlights.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )}
  </div>

  <div class="project-tags">
    {tags.map((tag) => (
      <span class="tag-badge">{tag}</span>
    ))}
  </div>
</article>

<style>
  .project-role {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 0.15rem;
  }

  .project-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
</style>
